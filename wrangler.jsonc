{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concierge-cockpit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockpit-local",
      "database_id": "local"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://example.cloudflareaccess.com"
  },
  "env": {
    "staging": {
      "name": "concierge-cockpit-staging",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://staging.cloudflareaccess.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-staging",
          "database_id": "53e6e61f-ce10-4197-b091-b02662db95fe"
        }
      ]
    },
    "production": {
      "name": "concierge-cockpit-production",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://production.cloudflareaccess.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-production",
          "database_id": "d4f98dd6-fdc5-40bf-8bf7-c31bbb0ac7ab"
        }
      ]
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concierge-cockpit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/ui",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockpit-local",
      "database_id": "local"
    }
  ],
  // Email Service send binding for `wrangler dev`.
  // Sending subdomain subcontractor.ww0.dev is verified (2026-10-18; see
  // README "Email pipeline").
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Warm-up cap: max emails sent per UTC day (D1-counted). Start low, ramp slowly.
  "vars": {
    "EMAIL_DAILY_LIMIT": "50"
  },
  "env": {
    "staging": {
      "name": "concierge-cockpit-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-staging",
          "database_id": "53e6e61f-ce10-4197-b091-b02662db95fe"
        }
      ],
      // NOTE: wrangler 3.x does not inherit vars/send_email into environments,
      // so these are repeated per env; the top-level entries cover `wrangler dev`.
      "vars": {
        "EMAIL_FROM": "Subcrew Staging <info@subcontractor.ww0.dev>",
        "EMAIL_REPLY_TO": "siim.liimand@gmail.com",
        "EMAIL_DAILY_LIMIT": "50"
      },
      "send_email": [{ "name": "SEND_EMAIL" }],
      "queues": {
        "consumers": [{ "queue": "email-events-staging" }]
      }
    },
    "production": {
      "name": "concierge-cockpit-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-production",
          "database_id": "d4f98dd6-fdc5-40bf-8bf7-c31bbb0ac7ab"
        }
      ],
      "vars": {
        "EMAIL_FROM": "Subcrew <info@subcontractor.ww0.dev>",
        "EMAIL_REPLY_TO": "siim.liimand@gmail.com",
        "EMAIL_DAILY_LIMIT": "50"
      },
      "send_email": [{ "name": "SEND_EMAIL" }],
      "queues": {
        "consumers": [{ "queue": "email-events-production" }]
      }
    }
  }
}

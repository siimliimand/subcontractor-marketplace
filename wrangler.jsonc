{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concierge-cockpit",
  "main": "src/worker/index.ts",
  // Cron fires every 5 minutes (SUBC-011): each tick runs the stale-sent
  // email resolution sweep; the hourly jobs (outreach widening, retention
  // purge, calendar fetch) gate on minute 0 inside runScheduledJobs so their
  // cadence is unchanged. Logic lives in src/worker/cron/* and
  // src/worker/email/resolve.ts; tests invoke the modules directly.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/ui",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockpit-local",
      "database_id": "local"
    }
  ],
  // Email Service send binding for `wrangler dev`.
  // Sending subdomain subcontractor.ww0.dev is verified (2026-10-18; see
  // README "Email pipeline").
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Workers AI binding for the phase 2 brief builder. NOTE: the pinned
  // miniflare in vitest-pool-workers (3.20241230.0) cannot resolve wrangler's
  // wrapped AI binding, so the top-level entry stays disabled — `npm test`
  // runs against this config. Local `wrangler dev` users can uncomment it for
  // AI drafting; the route falls back to a 502 + manual form without it.
  // "ai": { "binding": "AI" },
  // Warm-up cap: max emails sent per UTC day (D1-counted). Start low, ramp slowly.
  "vars": {
    "EMAIL_DAILY_LIMIT": "50"
  },
  "env": {
    "staging": {
      "name": "concierge-cockpit-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-staging",
          "database_id": "53e6e61f-ce10-4197-b091-b02662db95fe"
        }
      ],
      // NOTE: wrangler 3.x does not inherit vars/send_email into environments,
      // so these are repeated per env; the top-level entries cover `wrangler dev`.
      "vars": {
        "EMAIL_FROM": "Subcrew Staging <info@subcontractor.ww0.dev>",
        "EMAIL_REPLY_TO": "siim.liimand@gmail.com",
        "EMAIL_DAILY_LIMIT": "50",
        // SUBC-011: stale-sent resolution window (minutes) for the every-5-min
        // sweep; 10 min window + 5 min sweep bounds delivery-state settle time
        // to ~15 minutes.
        "EMAIL_RESOLVE_AFTER_MINUTES": "10",
        // Phase 4: expansion tracks — demand-gated flags start off; calendar
        // fetch is on (feeds only exist once staff register them).
        "CALENDAR_FETCH_ENABLED": "true",
        "CALENDAR_STALE_DAYS": "3",
        "CALENDAR_PURGE_DAYS": "14",
        "MAX_FEEDS_PER_COMPANY": "3",
        "MONETIZATION_PILOT_ENABLED": "false",
        "PLANNER_AI_ENABLED": "false"
      },
      "send_email": [{ "name": "SEND_EMAIL" }],
      "ai": { "binding": "AI" },
      "queues": {
        "consumers": [{ "queue": "email-events-staging" }]
      }
    },
    "production": {
      "name": "concierge-cockpit-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-production",
          "database_id": "d4f98dd6-fdc5-40bf-8bf7-c31bbb0ac7ab"
        }
      ],
      "vars": {
        "EMAIL_FROM": "Subcrew <info@subcontractor.ww0.dev>",
        "EMAIL_REPLY_TO": "siim.liimand@gmail.com",
        "EMAIL_DAILY_LIMIT": "50",
        "EMAIL_RESOLVE_AFTER_MINUTES": "10",
        "CALENDAR_FETCH_ENABLED": "true",
        "CALENDAR_STALE_DAYS": "3",
        "CALENDAR_PURGE_DAYS": "14",
        "MAX_FEEDS_PER_COMPANY": "3",
        "MONETIZATION_PILOT_ENABLED": "false",
        "PLANNER_AI_ENABLED": "false"
      },
      "send_email": [{ "name": "SEND_EMAIL" }],
      "ai": { "binding": "AI" },
      "queues": {
        "consumers": [{ "queue": "email-events-production" }]
      }
    }
  }
}
